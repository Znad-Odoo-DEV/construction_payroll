<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_payslip_advance_wizard_form" model="ir.ui.view">
        <field name="name">construction.payslip.advance.wizard.form</field>
        <field name="model">construction.payslip.advance.wizard</field>
        <field name="arch" type="xml">
            <form string="Advance Days">
                <field name="payslip_id" invisible="1"/>
                <field name="summary_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="alert alert-info" role="alert"
                     invisible="not reason">
                    <field name="reason" nolabel="1" readonly="1"/>
                </div>
                <group>
                    <group string="The Period">
                        <field name="employee_id" readonly="1"/>
                        <field name="attended_days" readonly="1"/>
                        <field name="period_days" readonly="1"/>
                        <field name="attendance_ratio" readonly="1"/>
                    </group>
                    <group string="Standing Now">
                        <field name="current_days" readonly="1"/>
                        <field name="currently_granted" readonly="1"/>
                        <field name="rate_per_day" readonly="1"/>
                    </group>
                </group>
                <group string="The Decision">
                    <group>
                        <field name="advance_days"/>
                        <field name="advance_amount" readonly="1"/>
                    </group>
                </group>
                <group>
                    <field name="note" nolabel="1" colspan="2"
                           placeholder="Why these days are being granted or refused. This is appended to the payslip's Notes &amp; Remarks."/>
                </group>
                <footer>
                    <button name="action_validate" type="object"
                            string="Validate" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
