    <!-- ==================================================================
         Labour vs staff separation. GROUP rules (not global), so they are
         OR-ed: each side's Officer and Manager both carry the same filter,
         and nobody is in both sides, so each user sees only their workforce.
         Staff = Office/Engineer employees (hr.employee.construction_is_office_staff);
         everyone else
         counts as labour.
         ================================================================== -->

    <record id="construction_payslip_labour_rule" model="ir.rule">
        <field name="name">Construction Payslip: labour only</field>
        <field name="model_id" ref="model_construction_payslip"/>
        <field name="groups" eval="[(4, ref('group_labour_payroll')), (4, ref('group_labour_payroll_manager'))]"/>
        <field name="domain_force">[('employee_id.construction_is_office_staff', '=', False)]</field>
    </record>
    <record id="construction_payslip_staff_rule" model="ir.rule">
        <field name="name">Construction Payslip: staff only</field>
        <field name="model_id" ref="model_construction_payslip"/>
