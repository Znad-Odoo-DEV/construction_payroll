<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_attachment_type_list" model="ir.ui.view">
        <field name="name">construction.attachment.type.list</field>
        <field name="model">construction.attachment.type</field>
        <field name="arch" type="xml">
            <list string="Attachment Types" editable="bottom">
                <field name="name"/>
                <field name="kind"/>
                <field name="factor"/>
                <field name="expense_type_id" options="{'no_create': True}"/>
                <field name="input_type_ids" widget="many2many_tags" options="{'no_create': True}"
                       groups="hr_payroll.group_hr_payroll_user"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_construction_attachment_type" model="ir.actions.act_window">
        <field name="name">Attachment Types</field>
        <field name="res_model">construction.attachment.type</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
