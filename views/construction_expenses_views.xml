<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================ Advance Salaries ============================ -->
    <record id="view_construction_advance_list" model="ir.ui.view">
        <field name="name">construction.advance.list</field>
        <field name="model">construction.advance</field>
        <field name="arch" type="xml">
            <list string="Advance Salaries">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="no_of_installments" string="No. of Inst."/>
                <field name="total_amount" sum="Total"/>
                <field name="outstanding_amount" sum="Outstanding"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_construction_advance_form" model="ir.ui.view">
        <field name="name">construction.advance.form</field>
        <field name="model">construction.advance</field>
        <field name="arch" type="xml">
            <form string="Advance">
                <header>
                    <button name="action_generate_installments" type="object"
                            string="Generate Installments" invisible="state != 'new'"/>
                    <button name="action_generate_deductions" type="object"
                            string="Generate Deductions" invisible="state == 'closed'"
                            help="One Salary Advance-Deduction per installment, in the month it is due. Installments that already have one are left alone."/>
                    <button name="action_confirm_payment" type="object" string="Payment Confirmed"
                            class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_run" type="object" string="Run"
                            invisible="state != 'in_payment'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'running'"/>
                    <button name="action_reset" type="object" string="Reset"
                            invisible="state == 'new'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="request_link"/>
                            <field name="total_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="employee_code"/>
                            <field name="no_of_installments"/>
                            <field name="approval_date"/>
                            <field name="date"/>
                            <field name="outstanding_amount"/>
                            <field name="salary_adjustment_id"
                                   groups="hr_payroll.group_hr_payroll_user"/>
                        </group>
                    </group>
                    <field name="installment_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="due_date"/>
                            <field name="amount"/>
                            <field name="attachment_id"/>
                            <field name="paid" widget="boolean_toggle"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_construction_advance" model="ir.actions.act_window">
        <field name="name">Advance Salaries</field>
        <field name="res_model">construction.advance</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================ Leave Expenses ============================ -->
    <record id="view_construction_leave_expense_list" model="ir.ui.view">
        <field name="name">construction.leave.expense.list</field>
        <field name="model">construction.leave.expense</field>
        <field name="arch" type="xml">
            <list string="Leave Expenses">
                <field name="name"/>
                <field name="state" widget="badge"/>
                <field name="expense_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="payable_amount" sum="Payable"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_construction_leave_expense_form" model="ir.ui.view">
        <field name="name">construction.leave.expense.form</field>
        <field name="model">construction.leave.expense</field>
        <field name="arch" type="xml">
            <form string="Leave Expense">
                <header>
                    <button name="action_pay_cash" type="object" string="Pay Through Cash"
                            invisible="state != 'created'"/>
                    <button name="action_pay_bank" type="object" string="Pay Through Bank"
                            invisible="state != 'created'"/>
                    <button name="action_attach_salary" type="object" string="Attach with Salary"
                            invisible="state != 'created'"/>
                    <button name="action_set_paid" type="object" string="Set Paid"
                            class="btn-primary" invisible="state not in ('in_payment', 'attached')"/>
                    <button name="action_reset" type="object" string="Reset"
                            invisible="state == 'created'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="request_link"/>
                            <field name="payable_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="employee_code"/>
                            <field name="expense_type" widget="radio"/>
                            <field name="approval_date"/>
                            <field name="eid_expiry_date"/>
                            <field name="hold_500"/>
                            <field name="payment_method"/>
                        </group>
                    </group>
                    <group string="Documents">
                        <field name="approved_ticket" filename="approved_ticket_filename"/>
                        <field name="approved_ticket_filename" invisible="1"/>
                        <field name="ticket_file" filename="ticket_file_filename"/>
                        <field name="ticket_file_filename" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_construction_leave_expense" model="ir.actions.act_window">
        <field name="name">Leave Expenses</field>
        <field name="res_model">construction.leave.expense</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================ Fines & Deductions ============================ -->
    <record id="view_construction_fine_list" model="ir.ui.view">
        <field name="name">construction.fine.list</field>
        <field name="model">construction.fine</field>
        <field name="arch" type="xml">
            <list string="Fines &amp; Deductions">
                <field name="state" widget="badge"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="total_fine_amount" sum="Total Fine"/>
                <field name="outstanding_amount" sum="Outstanding"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_construction_fine_form" model="ir.ui.view">
        <field name="name">construction.fine.form</field>
        <field name="model">construction.fine</field>
        <field name="arch" type="xml">
            <form string="Fine">
                <header>
                    <button name="action_generate_installments" type="object"
                            string="Generate Installments" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'running'"/>
                    <button name="action_reset" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="total_fine_amount"/>
                            <field name="employee_id"/>
                            <field name="fine_description"/>
                            <field name="requested_by"/>
                            <field name="no_of_installments"/>
                            <field name="claimed_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="fine_date"/>
                            <field name="supporting_document" filename="supporting_document_name"/>
                            <field name="supporting_document_name" invisible="1"/>
                            <field name="first_installment_due_date"/>
                            <field name="outstanding_amount"/>
                        </group>
                    </group>
                    <field name="installment_ids">
                        <list>
                            <field name="name"/>
                            <field name="month"/>
                            <field name="year"/>
                            <field name="state" widget="badge"/>
                            <field name="value"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_construction_fine" model="ir.actions.act_window">
        <field name="name">Fines &amp; Deductions</field>
        <field name="res_model">construction.fine</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================ End of Service ============================ -->
    <record id="view_construction_eos_list" model="ir.ui.view">
        <field name="name">construction.end.of.service.list</field>
        <field name="model">construction.end.of.service</field>
        <field name="arch" type="xml">
            <list string="End of Service">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="last_day_of_duty"/>
                <field name="years_of_service"/>
                <field name="total_settlement" sum="Total Settlement"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_construction_eos_form" model="ir.ui.view">
        <field name="name">construction.end.of.service.form</field>
        <field name="model">construction.end.of.service</field>
        <field name="arch" type="xml">
            <form string="End of Service">
                <header>
                    <button name="action_compute" type="object" string="Compute"
                            class="btn-primary" invisible="state != 'new'"
                            help="Work every amount out from the figures on this form as they stand: edit the absence days, the service, the wages or the leave balance, then press this."/>
                    <button name="action_refresh" type="object" string="Refresh from Employee"
                            invisible="state != 'new'"
                            help="Read the inputs again from the employee, the punches and Time Off - contract figures, service, last month's absence and overtime, leave balance - then compute. Overwrites what you typed in those inputs."/>
                    <button name="action_check" type="object" string="Check &amp; Verify"
                            invisible="state != 'new'"/>
                    <button name="action_in_payment" type="object" string="In Payments"
                            class="btn-primary" invisible="state != 'checked'"/>
                    <button name="action_set_paid" type="object" string="Set Paid"
                            invisible="state != 'in_payment'"/>
                    <button name="action_reset" type="object" string="Reset"
                            invisible="state == 'new'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,checked,in_payment,paid"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="profession"/>
                            <field name="nationality"/>
                            <field name="date_of_request"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="joining_date"/>
                            <field name="eid_visa_expiry"/>
                            <field name="last_day_of_duty"/>
                            <field name="years_of_service"/>
                            <field name="service_excluded_days"/>
                            <field name="received_payslip"/>
                            <field name="computed_on"/>
                            <field name="total_settlement"/>
                        </group>
                    </group>
                    <separator string="HR Review &amp; Note"/>
                    <field name="hr_review" placeholder="HR review notes…"/>
                    <notebook>
                        <page string="Signed NOR" name="nor">
                            <field name="nor_document" filename="nor_document_name"/>
                            <field name="nor_document_name" invisible="1"/>
                        </page>
                        <page string="E.O.S &amp; Gratuity" name="gratuity">
                            <group>
                                <group>
                                    <field name="gratuity_calculation_method"/>
                                    <field name="gratuity_basic_salary"/>
                                    <field name="gratuity_gross_salary"/>
                                </group>
                                <group>
                                    <field name="gratuity_amount"/>
                                    <field name="gratuity_years"/>
                                    <field name="gratuity_months"/>
                                    <field name="gratuity_days"/>
                                </group>
                            </group>
                            <group string="Gratuity Calculation">
                                <field name="gratuity_for_years"/>
                                <field name="gratuity_for_months"/>
                                <field name="gratuity_for_days"/>
                            </group>
                            <field name="gratuity_formula_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Leave Allowances" name="leave">
                            <group>
                                <group>
                                    <field name="leave_calculation_method"/>
                                    <field name="leave_basic_salary"/>
                                    <field name="leave_days_balance"/>
                                    <field name="leave_daily_rate"/>
                                    <field name="leave_amount_to_pay"/>
                                </group>
                                <group>
                                    <field name="leave_salaries_eligible"/>
                                    <field name="leave_salaries_balance"/>
                                    <field name="leave_total_payable"/>
                                </group>
                            </group>
                        </page>
                        <page string="Final Monthly Salary" name="final_salary">
                            <group string="Contract Details">
                                <group>
                                    <field name="fm_basic_salary"/>
                                    <field name="fm_travelling_allowance"/>
                                    <field name="fm_gross_salary"/>
                                    <field name="fm_rate_per_day"/>
                                    <field name="fm_ot_rate_regular"/>
                                </group>
                                <group>
                                    <field name="fm_house_allowance"/>
                                    <field name="fm_other_allowance"/>
                                    <field name="fm_ot_rate_off"/>
                                </group>
                            </group>
                            <group string="Attendance of this Month">
                                <group>
                                    <field name="fm_total_days"/>
                                    <field name="total_ot_regular"/>
                                </group>
                                <group>
                                    <field name="total_absence_days"/>
                                    <field name="total_ot_off"/>
                                </group>
                            </group>
                            <group string="Salary of this Month">
                                <group>
                                    <field name="fm_total_salary_month"/>
                                    <field name="fm_overtime_salary"/>
                                </group>
                                <group>
                                    <field name="fm_salary_adjustment"/>
                                    <field name="fm_type_of_adjustment"/>
                                    <field name="fm_net_salary"/>
                                </group>
                            </group>
                            <field name="salary_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Settlement" name="settlement">
                            <group>
                                <group>
                                    <field name="gratuity_amount"/>
                                    <field name="leave_total_payable"/>
                                    <field name="fm_net_salary"/>
                                </group>
                                <group>
                                    <field name="other_adjustments"/>
                                    <field name="total_settlement"/>
                                </group>
                            </group>
                            <field name="adjustments_html" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_construction_eos" model="ir.actions.act_window">
        <field name="name">End of Service</field>
        <field name="res_model">construction.end.of.service</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================ On-Hold ============================ -->
    <record id="view_construction_on_hold_list" model="ir.ui.view">
        <field name="name">construction.on.hold.list</field>
        <field name="model">construction.on.hold</field>
        <field name="arch" type="xml">
            <list string="On-Hold Amounts" editable="bottom">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="allowance_id" optional="show"/>
                <field name="attach" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_construction_on_hold" model="ir.actions.act_window">
        <field name="name">On-Hold Amounts</field>
        <field name="res_model">construction.on.hold</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
